# 이음(Ieum) 환경 변수 예시 — 실제 값으로 채워 .env 또는 셸 export로 사용
# (자세한 발급 위치는 docs/SUPABASE_SETUP.md 참고)

# Supabase Postgres 연결 문자열 (Project Settings → Database → Connection string)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.<ref>.supabase.co:5432/postgres

# Supabase API (Project Settings → API)
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...                 # anon public key
SUPABASE_JWT_SECRET=super-secret-jwt-secret      # JWT Settings → JWT Secret

# 자체 세션 쿠키 서명용 (긴 랜덤 문자열을 직접 생성)
IEUM_SECRET=change-me-to-a-long-random-string
