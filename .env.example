# TIPLOOP 환경 변수 — 이 파일을 .env 로 복사해서 채우세요.
#   cp .env.example .env
# (.env 는 git에 안 올라갑니다. 자세한 발급 위치는 docs/SUPABASE_SETUP.md)

# 공개값 (브라우저에 노출되는 값) — 프로젝트에 맞게 그대로 사용
SUPABASE_URL=https://ftiynbgisypjjkakzcif.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_여기에_프로젝트_키
# 이전 배포 호환용. 위 값이 있으면 비워도 됩니다.
SUPABASE_ANON_KEY=

# (선택) JWT Secret — 이제 토큰 검증을 Supabase에 위임하므로 없어도 동작합니다
SUPABASE_JWT_SECRET=
# Apple Developer와 Supabase provider 설정 및 실제 로그인을 검증한 뒤에만 1
APPLE_AUTH_ENABLED=0
# 🔒 로컬은 Session pooler(:5432), Vercel은 Transaction pooler(:6543)의
# 전체 URI를 사용하세요. 비밀번호의 예약문자는 percent-encode해야 합니다.
DATABASE_URL=

# 자체 세션 서명용 — 아무 긴 랜덤 문자열
IEUM_SECRET=change-me-to-a-long-random-string
# Vercel Cron 요청 검증용 — IEUM_SECRET과 다른 긴 랜덤 문자열
CRON_SECRET=change-me-to-another-long-random-string
# 로컬 HTTP 개발에서만 0. 배포 환경은 반드시 1.
SESSION_COOKIE_SECURE=1
# 최종 프로덕션 주소
SITE_URL=https://tiploop.vercel.app
# 공개 법률·지원 화면에 쓰는 실제 운영자 정보
OPERATOR_NAME=TIPLOOP 운영자
SUPPORT_EMAIL=
SUPPORT_URL=https://github.com/keestory/TIPLOOP/issues
# schema.sql을 원격에 먼저 적용·검증한 배포에서만 1
SKIP_DB_INIT=0
